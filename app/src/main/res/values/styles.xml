<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/tarjeta</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TituloTarjeta">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="DescTarjeta">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/texto_sec</item>
    </style>

    <!-- renglones etiqueta / valor -->
    <style name="Etiqueta">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_sec</item>
    </style>

    <style name="Valor">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="BotonGrande" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="BotonGrande.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- etiquetita de Disponible / No disponible -->
    <style name="ChipEstado">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Toolbar">
        <item name="android:background">@color/fondo</item>
        <item name="titleTextColor">@color/texto</item>
        <item name="subtitleTextColor">@color/texto_sec</item>
        <item name="navigationIconTint">@color/texto</item>
    </style>
</resources>
