<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- para consumir la API REST con Retrofit -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ExploradorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Explorador">

        <!-- Pantalla 1: Bienvenida y configuracion -->
        <activity
            android:name=".ui.BienvenidaActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla 2: Catalogo (Retrofit) -->
        <activity
            android:name=".ui.CatalogoActivity"
            android:exported="false" />

        <!-- Pantalla 3: Detalle del libro -->
        <activity
            android:name=".ui.DetalleActivity"
            android:exported="false" />

        <!-- Pantalla 4: Favoritos (Room, sin internet) -->
        <activity
            android:name=".ui.FavoritosActivity"
            android:exported="false" />
    </application>

</manifest>
